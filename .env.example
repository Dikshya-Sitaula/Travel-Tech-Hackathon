# Keep this value on the server. Never prefix it with VITE_ or commit a real key.
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
GEMINI_VISION_MODEL=gemini-3.6-flash
GROQ_API_KEYS=first-key,second-key,third-key
GROQ_ITINERARY_MODEL=openai/gpt-oss-20b
GROQ_ASSISTANT_MODEL=openai/gpt-oss-20b
LORA_GATEWAY_TOKEN=replace-with-a-long-random-secret
VITE_SOS_DEMO_MODE=true
# Optional for installed Android builds. It can also be changed from the SOS page at runtime.
VITE_EMERGENCY_SERVER_URL=
# Server-only SMS alert configuration. Keep these out of frontend variables.
SOS_ALERT_PHONE=+977xxxxxxxxxx
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
